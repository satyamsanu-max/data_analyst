# --- Local development -------------------------------------------------------
# SQLite needs no setup; `npm run dev` creates and seeds this on first run.
DATABASE_URL="file:./dev.db"

# --- Hosted only (see DEPLOY.md) ---------------------------------------------
# Postgres connection string for the application role.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
#
# Read-only role scoped to the `practice` schema, printed by
# `npm run provision:practice`. When unset, the SQL judge falls back to an
# in-process PGlite instance, which is what local development uses.
# PRACTICE_DATABASE_URL="postgresql://practice_ro:pass@host/db?sslmode=require"
#
# Public origin, used to build password-reset links.
# APP_URL="https://your-app.vercel.app"
#
# Password-reset email delivery. Without a key the link is logged to the server
# console instead of being emailed.
# RESEND_API_KEY="re_..."
# RESET_EMAIL_FROM="Interview Prep <noreply@yourdomain.com>"
