// Interview Prep — data model
// PostgreSQL for production / Neon.
// DATABASE_URL is loaded from .env or Vercel environment variables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A reference we cite for a question (NeetCode, Striver, LeetCode, GfG, ...).
model Source {
  id        String     @id @default(cuid())
  name      String     @unique
  homepage  String?
  kind      String // "roadmap" | "platform" | "book" | "article" | "company-report"
  notes     String?
  questions Question[]
}

/// Topic within a category, e.g. "Sliding Window" (DSA) or "Window Functions" (SQL).
model Topic {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  category  String // DSA | SQL | Probability | Statistics | ML | Python | Guesstimate
  /// Relative importance of this topic for Data Analyst / DS interviews (0-100).
  weight    Int        @default(50)
  questions Question[]
}

model Company {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  bucket    String // "tech" | "product" | "consulting" | "finance" | "other"
  questions QuestionCompany[]
}

model QuestionCompany {
  questionId String
  companyId  String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([questionId, companyId])
  @@index([companyId])
}

model Question {
  id       String @id
  category String // DSA | SQL | Probability | Statistics | ML | Python | Guesstimate
  title    String

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id])

  /// Reusable technique this question teaches, e.g. "Monotonic Stack".
  pattern    String?
  difficulty String // Easy | Medium | Hard

  estimatedMinutes Int

  sourceId   String?
  source     Source? @relation(fields: [sourceId], references: [id])
  sourceUrl  String?
  /// Free-text attribution shown in the UI, e.g. "NeetCode 150".
  sourceNote String?

  /// How often this shows up in real interviews (0-100).
  frequencyScore  Int @default(50)
  /// How much reusable pattern leverage it gives (0-100).
  patternValue    Int @default(50)
  /// How much distinct concept surface it covers (0-100).
  conceptCoverage Int @default(50)

  /// JSON string arrays.
  concepts      String @default("[]")
  prerequisites String @default("[]")
  skillsTested  String @default("[]")

  /// Question body. For DSA we store a short original restatement + link out.
  prompt      String?
  hint        String?
  solution    String?
  explanation String?

  /// How an answer is graded:
  ///   "sql"     - run the query against the practice DB and compare result sets
  ///   "numeric" - compare a typed number against answerSpec within a tolerance
  ///   "self"    - conceptual; the user grades themselves
  /// Set by the seeder, which proves SQL verifiability by actually running each
  /// reference solution rather than trusting a hand-maintained flag.
  verification String  @default("self")
  /// JSON: { value, tolerance, unit, alternates } for numeric grading.
  answerSpec   String?

  /// Guesstimate-specific
  framework   String?
  assumptions String?
  industry    String?
  year        Int?

  companies QuestionCompany[]
  progress  UserProgress[]
  tasks     DailyTask[]
  attempts  Attempt[]

  @@index([category])
  @@index([topicId])
  @@index([pattern])
}

/// An account. Passwords are stored only as a scrypt hash + salt, never plaintext.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  settings    UserSettings?
  progress    UserProgress[]
  plans       DailyPlan[]
  attempts    Attempt[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  deepDive    DeepDiveProgress[]
}

/// Server-side session. Revocable, unlike a self-contained token.
model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Fixed-window counter for rate limiting.
///
/// Lives in the database rather than in memory because a serverless deployment
/// runs many instances — an in-process counter would reset on every cold start
/// and be trivially bypassed.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime

  @@index([windowEnd])
}

/// One-time password reset token. Only its SHA-256 is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMinutes    Int      @default(150)
  difficultyMode  String   @default("balanced") // balanced | easy-first | interview-hard
  targetRole      String   @default("Data Analyst")
  /// JSON array of company slugs.
  targetCompanies String   @default("[]")
  theme           String   @default("dark")
  startDate       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserProgress {
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status           String    @default("not_started") // not_started|attempted|solved|solved_quickly|solved_with_hint|failed|needs_review|mastered
  attemptCount     Int       @default(0)
  failedCount      Int       @default(0)
  hintUsedCount    Int       @default(0)
  lastAttemptDate  DateTime?
  /// Seconds, most recent successful/attempted solve.
  lastSolveSeconds Int?
  totalSeconds     Int       @default(0)
  /// 0-100.
  masteryScore     Int       @default(0)
  /// Spaced repetition: when this should resurface.
  nextReviewDate   DateTime?
  timesOverrun     Int       @default(0)

  @@id([userId, questionId])
  @@index([questionId])
}

model DailyPlan {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayNumber      Int
  date           String // yyyy-mm-dd, local
  targetMinutes  Int
  plannedMinutes Int
  status         String      @default("active") // active | completed
  createdAt      DateTime    @default(now())
  tasks          DailyTask[]

  @@unique([userId, date])
  @@unique([userId, dayNumber])
}

model DailyTask {
  id             String    @id @default(cuid())
  planId         String
  plan           DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question  @relation(fields: [questionId], references: [id])
  position       Int
  plannedMinutes Int
  status         String    @default("pending") // pending | in_progress | done | skipped
  elapsedSeconds Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  outcome        String? // independent | minor_hint | major_hint | unsolved
  /// True when the slot was produced by a swap rather than the original generation.
  swapped        Boolean   @default(false)

  @@unique([planId, position])
  @@index([questionId])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  planId     String?
  createdAt  DateTime @default(now())
  seconds    Int
  outcome    String // independent | minor_hint | major_hint | unsolved
  hintUsed   Boolean  @default(false)
  overrun    Boolean  @default(false)
  /// True when the app graded this objectively (SQL result set or numeric answer)
  /// rather than taking the user's word for it.
  verified   Boolean  @default(false)
  /// True when `seconds` came from a real start/stop clock, as in a scheduled
  /// session. False for practice from a question page, where the app cannot
  /// know how long you actually worked — untimed attempts are excluded from
  /// solve-time statistics and never earn a speed bonus or an overrun penalty.
  timed      Boolean  @default(true)
  /// The submission itself, kept so the attempt history is reviewable.
  submission String?

  @@index([userId, createdAt])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Deep Dive into Data & Product
//
// A SEPARATE library from the Data Analyst question bank. These rows live in
// their own tables on purpose: `loadSchedulerQuestions()` reads the whole
// `Question` table with no WHERE clause, so anything stored there would become
// eligible for the 150-minute Daily Practice plan the moment it was seeded.
// Keeping Deep Dive out of `Question` makes that leak structurally impossible
// rather than a flag someone has to remember to set.
// ---------------------------------------------------------------------------

/// One piece of Deep Dive material: a concept, an interview question, a case,
/// a guesstimate, or an industry primer.
model DeepDiveContent {
  id String @id

  /// DATA | PRODUCT | CONSULTING. Kept as a string so a new domain is a data
  /// change, not a migration.
  domain      String
  /// Slug within the domain, e.g. "excel", "power-bi", "root-cause".
  section     String
  /// CONCEPT | QUESTION | CASE | GUESSTIMATE | INDUSTRY_PRIMER
  contentType String
  /// Filter bucket within the section, e.g. "Lookup", "DAX", "Profitability".
  category    String

  title      String
  difficulty String @default("Medium") // Easy | Medium | Hard

  /// The prompt itself. Null for CONCEPT rows, which lead with `explanation`.
  question            String?
  /// Nudges the candidate's thinking without giving away the answer.
  hint                String?
  /// What a candidate could actually say out loud to an interviewer.
  interviewAnswer     String?
  /// The deepest teaching section: reasoning, worked steps, edge cases.
  detailedExplanation String?

  /// Concept-page body (what it is / how it works / when to use it).
  explanation    String?
  /// Worked example, kept separate so the UI can style it as a callout.
  example        String?
  /// Formula / DAX / Tableau calc / SQL, as JSON [{ lang, label, code }].
  codeBlocks     String  @default("[]")
  /// Named framework this follows, e.g. "CIRCLES", "Profitability Tree".
  framework      String?
  /// JSON string array.
  commonMistakes String  @default("[]")
  /// JSON string array of likely interviewer follow-ups.
  followUps      String  @default("[]")
  /// JSON string array of other DeepDiveContent ids (concepts <-> questions).
  relatedIds     String  @default("[]")
  /// JSON string array, powers the filter chips and search.
  tags           String  @default("[]")

  /// Evidence-based attribution ONLY. Null means the source did not say, which
  /// is very different from "unknown company" — never guessed or inferred.
  company String?
  role    String?
  year    Int?

  /// REAL_INTERVIEW | INTERVIEW_EXPERIENCE | CASEBOOK_INTERVIEW_CASE |
  /// COMMON_INTERVIEW_QUESTION | ADAPTED_PRACTICE
  /// Governs the badge shown in the UI. Only the first three may claim a real
  /// interview, and only with a source to back it.
  sourceType String
  /// high | medium | low — how well the sources support the claim.
  confidence String @default("medium")

  /// Cross-reference to the existing Data Analyst bank, so shared material
  /// (the 35 seeded guesstimates) is surfaced here rather than duplicated.
  existingQuestionId String?

  /// Deep Dive rows are never Daily Practice candidates. Both flags exist so
  /// the intent is greppable and assertable in tests, not just implied by
  /// which table the row happens to sit in.
  isDeepDive              Boolean @default(true)
  isDailyPracticeEligible Boolean @default(false)

  sources  DeepDiveSource[]
  progress DeepDiveProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain, section])
  @@index([contentType])
  @@index([section, contentType])
  @@index([company])
}

/// A citation. One canonical question can carry several of these — that is how
/// deduplication works: the same question found on GitHub, GeeksforGeeks and in
/// a casebook stays ONE row with three sources, never three rows.
model DeepDiveSource {
  id        String          @id @default(cuid())
  contentId String
  content   DeepDiveContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// CASEBOOK | GITHUB | GEEKSFORGEEKS | GLASSDOOR | INTERVIEW_REPORT |
  /// PUBLIC_ASSESSMENT | ADAPTED | COMMON_INTERVIEW
  sourceType String
  name       String
  title      String?
  url        String?
  /// Page number for casebook sources.
  page       Int?
  /// Why we believe this source supports the claim, in one line.
  evidence   String?

  @@index([contentId])
}

/// Deep Dive progress. Deliberately NOT `UserProgress`: that table is keyed to
/// `Question` by foreign key and feeds mastery, streaks and the scheduler.
/// Writing Deep Dive activity there would move Daily Practice numbers.
model DeepDiveProgress {
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId String
  content   DeepDiveContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// NOT_STARTED | ATTEMPTED | SOLVED | NEEDS_REVIEW
  status     String  @default("NOT_STARTED")
  attempts   Int     @default(0)
  bookmarked Boolean @default(false)
  /// True once the user has revealed the answer, so the UI can show "seen".
  revealed   Boolean @default(false)

  lastAttemptedAt DateTime?
  solvedAt        DateTime?
  updatedAt       DateTime  @updatedAt

  @@id([userId, contentId])
  @@index([contentId])
  @@index([userId, status])
}
